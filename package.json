{
  "name": "dashboard-cierre-ti",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare:ui": "node tools/prepare.cjs",
    "build": "node tools/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:visual": "node tools/test-visual.cjs",
    "package:projects": "node tools/projects.cjs",
    "configure:xlsx": "node tools/configure-xlsx.cjs",
    "test:powerquery": "node --test tests/powerquery.test.cjs",
    "qa:powerquery": "node tools/export-powerquery-qa.cjs",
    "check": "node tools/check.cjs",
    "check:schemas": "node tools/check-schemas.cjs",
    "release:snapshot": "node tools/snapshot-release.cjs",
    "check:snapshot": "node tools/check-snapshot.cjs",
    "test:snapshot": "node tools/test-snapshot.cjs",
    "release:local": "npm test && npm run build && npm run test:visual && npm run package:projects && npm run check"
  },
  "dependencies": {
    "lucide": "1.67.0",
    "plotly.js-dist-min": "4.2.0"
  },
  "devDependencies": {
    "@microsoft/powerquery-parser": "5.0.0",
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0",
    "fflate": "0.8.2",
    "powerbi-visuals-api": "5.11.1",
    "powerbi-visuals-tools": "7.2.1",
    "typescript": "5.5.4"
  }
}
