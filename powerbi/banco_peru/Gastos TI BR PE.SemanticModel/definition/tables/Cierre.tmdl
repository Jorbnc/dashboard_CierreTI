	partition Cierre = m
		mode: import
		source =
				let
				    SourceName = List.Last(Text.Split(Text.Replace(pWorkbookPath, "\", "/"), "/")),
				    Workbook = Binary.Buffer(File.Contents(pWorkbookPath)),
				    Result = fxCierreXlsx(Workbook, SourceName, "banco_peru")
				in
				    Result

