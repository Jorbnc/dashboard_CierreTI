	partition Cierre = m
		mode: import
		source =
				let
				    SourceName = List.Last(Text.Split(Text.Replace(pWorkbookPath, "\", "/"), "/")),
				    Workbook = Binary.Buffer(File.Contents(pWorkbookPath)),
				    Members = {"retail_chile", "retail_peru"},
				    Result = Table.Combine(List.Transform(Members, (member) =>
				        Table.TransformColumns(fxCierreXlsx(Workbook, SourceName, member), {{"id", each "retail|" & _, type text}})))
				in
				    Result
